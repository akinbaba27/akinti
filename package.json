{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx --env-file-if-exists=.env.local scripts/check-env.ts --groups",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint && tsx scripts/i18n-check.ts",
    "i18n-check": "tsx scripts/i18n-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "worker:once": "tsx --env-file-if-exists=.env.local scripts/worker.ts --once",
    "sidecar": "node scripts/run-sidecar.mjs",
    "seed:backing-tracks": "tsx --env-file-if-exists=.env.local scripts/seed-backing-tracks.ts",
    "seed:challenges": "tsx --env-file-if-exists=.env.local scripts/seed-challenges.ts",
    "seed:plans": "tsx --env-file-if-exists=.env.local scripts/seed-plans.ts",
    "check-env": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "check-env:worker": "tsx --env-file-if-exists=.env.local scripts/check-env.ts --worker",
    "check-env:groups": "tsx --env-file-if-exists=.env.local scripts/check-env.ts --strict-groups",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/apply-migrations.ts",
    "db:migrate:dry": "tsx --env-file-if-exists=.env.local scripts/apply-migrations.ts --dry-run",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/apply-migrations.ts --seed",
    "verify:live": "tsx scripts/verify-live.ts",
    "cleanup:test-accounts": "tsx --env-file-if-exists=.env.local scripts/cleanup-test-accounts.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "perf": "npm run build && tsx scripts/perf-budget.ts"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "clsx": "^2.1.1",
    "extendable-media-recorder": "^9.2.40",
    "extendable-media-recorder-wav-encoder": "^7.0.140",
    "idb-keyval": "^6.3.0",
    "iyzipay": "^2.0.69",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "pitchy": "^4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.12.11",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "pg": "^8.23.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "browserslist": "^4.28.8",
    "qs": "^6.15.4"
  }
}
